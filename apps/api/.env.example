# Server
PORT=4000
SUPERCODE_JSON_BODY_LIMIT=10mb

# Auth (Better-Auth)
BETTER_AUTH_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# Database (terminal DB)
DATABASE_URL=postgresql://user:password@localhost:5432/supercode_terminal

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Provider API Keys
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
MINIMAX_API_KEY=
MINIMAX_MAX_TOKENS=4096
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=minimaxai/minimax-m3
NVIDIA_MAX_TOKENS=8192
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
MERGE_DEV_API_KEY=
ORCAROUTER_API_KEY=
CONCENTRATEAI_API_KEY=
